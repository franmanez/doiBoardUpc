msgid "plugins.generic.doiBoardUpc.displayName"
msgstr "Módulo DOIBoard UPC"

msgid "plugins.generic.doiBoardUpc.description"
msgstr ""
"Añade, en la página de artículo, un enlace a la web 'DOIBoard Crossref UPC' (https://doi.upc.edu). "
"Esta web, implementada por la UPC (Universitat Politècnica de Catalunya), es un frontend que consume la API REST de Crossref, "
"y nos permite obtener información sobre los DOIs registrados a Crossref."

msgid "plugins.generic.doiBoardUpc.title"
msgstr "Ver información del DOI en DOIBoard Crossref (by UPC)"

